<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{HH:mm:ss.SSS} %-5level %logger{40} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="com.dentallab.domain.payment" level="DEBUG"/>
    <logger name="com.dentallab.domain.payment.service.impl" level="DEBUG"/>
    <logger name="com.dentallab.domain.pricing" level="DEBUG"/>
</configuration>
